# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coopmaps
DB_USER=coopmaps_user
DB_PASSWORD=your_secure_password_here

# Redis Configuration (for sessions and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_very_long_secure_random_string_here_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=another_very_long_secure_random_string_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email Configuration (for password reset, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@principle5.coop
SMTP_PASSWORD=your_email_password
SMTP_FROM=Co-opMaps <noreply@principle5.coop>

# Membership Verification (Principle 5 specific)
PRINCIPLE5_API_KEY=your_principle5_api_key_here
MEMBERSHIP_CHECK_ENABLED=true

# Storage (AWS S3 or MinIO)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
AWS_S3_BUCKET=coopmaps-files

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret_here
SESSION_COOKIE_SECURE=false

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# Application URL (for email links)
APP_URL=http://localhost:3000

# Export Configuration
EXPORT_TEMP_DIR=./exports
EXPORT_EXPIRY_HOURS=24

# Geocoding (optional - for geographic features)
GEOCODING_API_KEY=
GEOCODING_PROVIDER=opencage

# Notifications
EMAIL_DIGEST_ENABLED=true
EMAIL_DIGEST_SCHEDULE=0 9 * * *

# Admin
ADMIN_EMAIL=admin@principle5.coop
