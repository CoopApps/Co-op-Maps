# Railway/Render Environment Variables
# Copy these to your Railway/Render environment variables section

# Required: Production mode
NODE_ENV=production

# Required: Database URL (automatically set by Railway/Render when you add PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/database

# Required: Admin password for community maps moderation
# Generate a strong password or use bcrypt hash
ADMIN_PASSWORD=change_this_to_secure_password

# Required: JWT secret for token generation
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_random_secret_string

# Required: CORS origin (allow all or specify your frontend URL)
CORS_ORIGIN=*

# Optional: Port (Railway/Render sets this automatically)
# PORT=3000

# Optional: Skip Puppeteer download (fixes build issues)
PUPPETEER_SKIP_DOWNLOAD=true

# Optional: Email configuration (for notifications to map creators)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Co-opMaps <noreply@yourdomain.com>
